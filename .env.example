# API Configuration
# Backend API URL (update with your server IP for physical devices)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket URL (update with your server IP for physical devices)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Print Service URL (optional - can be configured in Settings screen)
# For localhost testing
EXPO_PUBLIC_PRINT_SERVICE_URL=http://localhost:9100
# For network/tablet usage, use your computer's local IP:
# EXPO_PUBLIC_PRINT_SERVICE_URL=http://192.168.1.100:9100

# Firebase Configuration
# Note: Firebase config for mobile is in google-services.json (Android)
# and GoogleService-Info.plist (iOS). No env vars needed.

# Development Notes:
# - For Android Emulator: localhost works
# - For iOS Simulator: localhost works
# - For Physical Devices: Replace localhost with your computer's IP address
#   Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
